# ─── The Advancement Place — environment configuration ─────────────────────────
# Copy to `.env` for local development. Never commit `.env` or real secrets.
# All values are validated at startup in src/lib/env.ts. None of these are
# exposed to the browser (no NEXT_PUBLIC_ prefix is used anywhere).

# PostgreSQL connection string (required).
# Local:      postgresql://tap:tap@localhost:5432/tap?schema=public
# Production: use your provider's pooled URL with sslmode=require, e.g. Neon/Supabase/Railway.
DATABASE_URL="postgresql://tap:tap@localhost:5432/tap?schema=public"

# Public base URL of the site, no trailing slash (required in production).
# Used for canonical URLs, sitemap, structured data and links in emails.
APP_URL="http://localhost:3000"

# Secret used to key hashed identifiers (rate-limit keys). At least 32 chars.
# Generate with:  openssl rand -hex 32
# The app refuses to start in production with the dev placeholder below.
SESSION_SECRET="dev-only-secret-change-me-0123456789abcdef0123456789"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Without SMTP_HOST, emails are printed to the console in development and NOT
# sent in production (the admin dashboard shows a warning). Submissions are
# always saved regardless.
# Any SMTP provider works: Brevo, Mailgun, Amazon SES, Zoho, Resend (SMTP),
# or Gmail/Google Workspace with an App Password (low daily sending limits).
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # "true" for port 465
# SMTP_USER=""
# SMTP_PASSWORD=""
# Sender shown on emails. Must be an address/domain verified with your provider.
EMAIL_FROM="The Advancement Place <no-reply@theadvancementplace.com>"
# Inbox that receives new-enquiry notifications.
NOTIFY_EMAIL="advancementplace@gmail.com"

# ─── Policies ──────────────────────────────────────────────────────────────────
# Require candidates to confirm their email before applying (needs working SMTP).
REQUIRE_EMAIL_VERIFICATION="false"
# Maximum CV / attachment size in MB (max 7).
MAX_UPLOAD_MB="5"
# Days before CVs on unsuccessful/withdrawn applications and attachments on
# resolved enquiries are purged by `npm run retention:purge -- --yes`.
RETENTION_DAYS="365"
# debug | info | warn | error
LOG_LEVEL="info"

# ─── Scripts only ──────────────────────────────────────────────────────────────
# Allow `npm run db:seed:demo` when NODE_ENV=production (staging/demo sites only).
# ALLOW_DEMO_DATA="false"
# Integration tests use a separate database (never point this at real data).
# TEST_DATABASE_URL="postgresql://tap:tap@localhost:5432/tap_test?schema=public"
