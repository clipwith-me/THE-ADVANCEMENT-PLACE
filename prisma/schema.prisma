// The Advancement Place — relational schema.
// Every change ships as a migration (`npm run db:migrate`). Reference data
// (categories) lives in prisma/seed.ts; demo vacancies in prisma/seed-demo.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & access ────────────────────────────────────────────────────────

enum Role {
  CANDIDATE
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique // stored lower-cased
  passwordHash    String
  name            String
  role            Role          @default(CANDIDATE)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sessions          Session[]
  tokens            AuthToken[]
  profile           CandidateProfile?
  files             StoredFile[]          @relation("FileOwner")
  applications      Application[]
  jobsCreated       Job[]                 @relation("JobCreatedBy")
  statusChanges     ApplicationStatusEvent[]
  applicationNotes  ApplicationNote[]
  auditEvents       AuditEvent[]

  @@index([role, createdAt])
}

model Session {
  // SHA-256 of the random cookie token; the raw token never touches the DB.
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─── Candidate profile ────────────────────────────────────────────────────────

enum Qualification {
  SSCE
  OND
  HND
  BACHELORS
  PGD
  MASTERS
  DOCTORATE
  PROFESSIONAL_CERTIFICATION
  OTHER
}

enum NyscStatus {
  COMPLETED
  SERVING
  AWAITING_MOBILISATION
  EXEMPTED
  NOT_APPLICABLE
}

model CandidateProfile {
  id                  String         @id @default(cuid())
  userId              String         @unique
  phone               String?
  state               String?
  city                String?
  headline            String?
  highestQualification Qualification?
  qualificationDetail String? // free text, e.g. "B.Sc. Accounting" or the "Other" description
  institution         String?
  courseOfStudy       String?
  graduationYear      Int?
  nyscStatus          NyscStatus? // optional by design — never required
  certifications      String?
  portfolioUrl        String?
  linkedinUrl         String?
  about               String?
  currentCvId         String?        @unique
  photoId             String?        @unique // passport photograph, for identification
  // Set by the server only when the completeness rules pass; the gate always
  // re-evaluates live data, so this is informational (dashboards/metrics).
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCv  StoredFile?       @relation("CurrentCv", fields: [currentCvId], references: [id], onDelete: SetNull)
  photo      StoredFile?       @relation("Photo", fields: [photoId], references: [id], onDelete: SetNull)
  skills     CandidateSkill[]
  education  EducationRecord[]
  experience WorkExperience[]

  @@index([state])
  @@index([completedAt])
}

model Skill {
  id         String           @id @default(cuid())
  name       String // display form
  slug       String           @unique // normalised (lower-case, single spaces)
  candidates CandidateSkill[]
}

model CandidateSkill {
  profileId String
  skillId   String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model EducationRecord {
  id            String           @id @default(cuid())
  profileId     String
  institution   String
  qualification Qualification
  courseOfStudy String?
  startYear     Int?
  endYear       Int?
  createdAt     DateTime         @default(now())
  profile       CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model WorkExperience {
  id          String           @id @default(cuid())
  profileId   String
  employer    String
  title       String
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean          @default(false)
  description String?
  createdAt   DateTime         @default(now())
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// ─── Private documents ────────────────────────────────────────────────────────

enum FileKind {
  CV
  PHOTO
  ENQUIRY_ATTACHMENT
}

model StoredFile {
  id           String    @id @default(cuid())
  kind         FileKind
  ownerId      String? // null for anonymous enquiry attachments (admin-only access)
  originalName String // sanitised display name only — never used as a path
  mimeType     String // derived from content sniffing, not the browser
  sizeBytes    Int
  sha256       String
  storageKey   String    @unique // server-generated, opaque
  createdAt    DateTime  @default(now())

  owner             User?             @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  currentCvOf       CandidateProfile? @relation("CurrentCv")
  photoOf           CandidateProfile? @relation("Photo")
  applications      Application[]     @relation("ApplicationCv")
  photoApplications Application[]     @relation("ApplicationPhoto")
  enquiries         Enquiry[]

  @@index([ownerId, kind])
}

// Default storage backend: bytes live in PostgreSQL so CVs are private,
// persistent across redeploys and covered by database backups without extra
// infrastructure. Swap the StorageProvider for S3/R2 when volume demands it.
model FileBlob {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SalaryPeriod {
  MONTH
  YEAR
}

model JobCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  jobs      Job[]
}

model Job {
  id                 String          @id @default(cuid())
  slug               String          @unique
  title              String
  employerName       String?
  showEmployer       Boolean         @default(false) // only when the client is authorised to publish it
  summary            String
  description        String
  responsibilities   String[]
  requirements       String[]
  qualifications     String[]
  skills             String[]
  employmentType     EmploymentType
  workArrangement    WorkArrangement
  state              String
  city               String?
  salaryMin          Int?
  salaryMax          Int?
  salaryPeriod       SalaryPeriod?
  experienceYearsMin Int?
  experienceYearsMax Int?
  deadline           DateTime? // applications accepted until the end of this instant
  applyInstructions  String?
  status             JobStatus       @default(DRAFT)
  featured           Boolean         @default(false)
  isDemo             Boolean         @default(false)
  publishedAt        DateTime?
  closedAt           DateTime?
  categoryId         String
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  category     JobCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([status, publishedAt])
  @@index([status, deadline])
  @@index([categoryId, status])
  @@index([state])
  @@index([isDemo])
}

// ─── Applications ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  SUCCESSFUL
  UNSUCCESSFUL
  WITHDRAWN
}

model Application {
  id              String            @id @default(cuid())
  jobId           String
  candidateId     String
  cvFileId        String?
  photoFileId     String? // passport photo as it was when the candidate applied
  status          ApplicationStatus @default(SUBMITTED)
  coverMessage    String?
  // Candidate details as submitted, so later profile edits don't rewrite history.
  profileSnapshot Json
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  job       Job                      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate User                     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cvFile    StoredFile?              @relation("ApplicationCv", fields: [cvFileId], references: [id], onDelete: SetNull)
  photoFile StoredFile?              @relation("ApplicationPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  events    ApplicationStatusEvent[]
  notes     ApplicationNote[]

  // One application per candidate per vacancy — enforced by the database.
  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([status, createdAt])
}

model ApplicationStatusEvent {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

// Internal only — never shown to candidates.
model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  authorId      String?
  body          String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

// ─── Enquiries ────────────────────────────────────────────────────────────────

enum EnquiryType {
  CAREER_ASSISTANCE
  FREELANCE_OUTSOURCING
  CONTACT
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Enquiry {
  id               String        @id @default(cuid())
  type             EnquiryType
  status           EnquiryStatus @default(NEW)
  name             String
  email            String
  phone            String?
  organization     String?
  subject          String? // contact subject, or freelance/outsourcing service type
  message          String
  qualification    Qualification? // career assistance
  careerInterests  String? // career assistance
  attachmentId     String?
  adminNotes       String?
  // Null when no notification was sent (e.g. email not configured or failed).
  notifiedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attachment       StoredFile?   @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
}

// ─── Platform ─────────────────────────────────────────────────────────────────

// Append-only record of security-relevant and administrative actions.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Fixed-window counters shared by every app instance. Keys contain hashed
// identifiers only (never raw IPs or emails).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Single-row table of admin-editable site settings.
model SiteSettings {
  id                   Int      @id @default(1)
  publicJobPreview     Boolean  @default(true)
  requireCvForProfile  Boolean  @default(true)
  requirePhotoForProfile Boolean @default(true)
  applicationsOpen     Boolean  @default(true)
  announcement         String?
  updatedAt            DateTime @updatedAt
}
